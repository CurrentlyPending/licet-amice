		{
			dependencies: ["024BBC15CA0EA6E1"]
			description: ["This magnificent piece of machinery known as the &cHearth&r is the best appliance anyone could ever ask for. It is able to grant a chilling or heating effect to nearby blocks when it's fueled and granted a redstone signal. A signal to the sides will grant chill, while a signal to the back or bottom will grant warmth. Both effects can be active at the same time."]
			icon: "cold_sweat:hearth"
			id: "295B03FF2D1EF23A"
			invisible: true
			invisible_until_tasks: 1
			subtitle: "Don't mess with the thermostat!"
			tasks: [
