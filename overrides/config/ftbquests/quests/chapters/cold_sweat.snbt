	quests: [
		{
			description: ["This world is much tougher than most! The weather is unforgiving here, and will do everything in its power to kill you. But fear not! Through human ingenuity, even nature can be quelled."]
			icon: "alexscaves:ambersol"
			id: "024BBC15CA0EA6E1"
			rewards: [{
				id: "756A731FBD17EE76"
				item: "cold_sweat:thermometer"
