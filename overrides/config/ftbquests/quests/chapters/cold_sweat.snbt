			title: "To make a house a home"
			x: -0.7d
			y: -1.4d
		}
		{
			dependencies: ["024BBC15CA0EA6E1"]
			description: ["In the fiery pits of hell grows a peculiar plant charged by the writhing souls of the damned. The sprouts that grow on these stalks are thus surrounded by an extremely cold aura that they are quite keen on sharing. When consumed, the sprouts will lower your internal temperature quite significantly, making trips to the blazing Nether much more manageable. They can also be planted on Soul Sand, allowing them to be farmed outside of the hellish depths, though they'll require a source of heat to grow properly."]
			icon: "cold_sweat:soul_sprout"
			id: "1DDBA32A6E6DDC98"
			invisible: true
			invisible_until_tasks: 1
			subtitle: "Ghastly farming"
			tasks: [
				{
					dimension: "minecraft:the_nether"
					id: "423793E30D49A694"
					title: "Visit the Nether"
					type: "dimension"
